# WhatsApp AI Agent Environment Configuration
# Copy this file to .env and fill in your actual API credentials

# WhatsApp Business API Configuration
WHATSAPP_API_TOKEN=your_whatsapp_business_api_token_here
WHATSAPP_CHANNEL_ID=your_whatsapp_channel_id_here  
WHATSAPP_API_URL=https://graph.facebook.com/v19.0

# OpenAI Configuration for Content Summarization
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Logging Configuration
LOG_FILE_PATH=logs/app.log
LOG_LEVEL=INFO

# Scheduling Configuration
DEFAULT_POST_TIME=09:00
N_TOP_ARTICLES=2

# IMPORTANT SECURITY NOTES:
# - Never commit your real .env file to version control
# - Keep your API keys secure and never share them
# - The .env file is already in .gitignore to prevent accidental commits
# - Use different API keys for development and production environments